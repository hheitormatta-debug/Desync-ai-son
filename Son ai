-- Função para atualizar todos os textos
local function atualizarIdioma()
    if not idiomaAtual then return end
    
    title.Text = textos[idiomaAtual].titulo
    statusLabel.Text = desyncAtivo and textos[idiomaAtual].statusAtivado or textos[idiomaAtual].statusDesativado
    desyncButton.Text = textos[idiomaAtual].botaoDesync
    desativarButton.Text = textos[idiomaAtual].botaoDesativar
    infoLabel.Text = textos[idiomaAtual].info
    
    if youTextLabel then
        youTextLabel.Text = textos[idiomaAtual].marcador
    end
end

-- Função para criar marcador
local function criarMarcador()
    local character = player.Character
    if not character then return end
    local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
    if not humanoidRootPart then return end
    
    if youLabel then
        youLabel:Destroy()
    end
    
    desyncPosicaoSalva = humanoidRootPart.Position
    
    youLabel = Instance.new("Part")
    youLabel.Name = "YouLabel"
    youLabel.Size = Vector3.new(1, 1, 1)
    youLabel.CFrame = CFrame.new(desyncPosicaoSalva + Vector3.new(0, 3, 0))
    youLabel.Anchored = true
    youLabel.CanCollide = false
    youLabel.Transparency = 1
    youLabel.Parent = workspace
    
    local billboardGui = Instance.new("BillboardGui")
    billboardGui.Size = UDim2.new(0, 200, 0, 50)
    billboardGui.StudsOffset = Vector3.new(0, 0, 0)
    billboardGui.AlwaysOnTop = true
    billboardGui.Enabled = true
    billboardGui.Parent = youLabel
    
    local textLabel = Instance.new("TextLabel")
    textLabel.Size = UDim2.new(1, 0, 1, 0)
    textLabel.BackgroundTransparency = 1
    textLabel.Text = textos[idiomaAtual].marcador
    textLabel.TextColor3 = Color3.fromRGB(100, 200, 255)
    textLabel.TextSize = 40
    textLabel.Font = Enum.Font.GothamBold
    textLabel.TextStrokeTransparency = 0
    textLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    textLabel.Parent = billboardGui
    
    youTextLabel = textLabel
    
    print("📍 Marcador criado na posição:", desyncPosicaoSalva)
end

-- Detecção de respawn E TELETRANSPORTE
local function setupCharacterDetection()
    if characterConnection then
        characterConnection:Disconnect()
    end
    
    -- Detectar quando player renasce
    characterConnection = player.CharacterAdded:Connect(function(character)
        if desyncAtivo then
            local hrp = character:WaitForChild("HumanoidRootPart")
            wait(0.5)
            criarMarcador()
            print("🔄 Player renasceu! Marcador atualizado!")
        end
    end)
    
    -- Detectar teletransporte (mudança grande de posição)
    local lastPosition = nil
    
    if tpCheckConnection then
        tpCheckConnection:Disconnect()
    end
    
    tpCheckConnection = game:GetService("RunService").Heartbeat:Connect(function()
        if not desyncAtivo then
            if tpCheckConnection then
                tpCheckConnection:Disconnect()
                tpCheckConnection = nil
            end
            return
        end
        
        local character = player.Character
        if character then
            local hrp = character:FindFirstChild("HumanoidRootPart")
            if hrp then
                if lastPosition then
                    local distance = (hrp.Position - lastPosition).Magnitude
                    
                    -- Se moveu mais de 50 studs instantaneamente = teletransporte
                    if distance > 50 then
                        print("🌀 Teletransporte detectado! Atualizando marcador...")
                        criarMarcador()
                    end
                end
                
                lastPosition = hrp.Position
            end
        end
    end)
end

-- Ativar desync
local function ativarDesync()
    desyncAtivo = true
    statusLabel.Text = textos[idiomaAtual].statusAtivado
    statusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
    
    pcall(function()
        setfflag("NextGenReplicatorEnabledWrite4", "True")
    end)
    
    criarMarcador()
    setupCharacterDetection()
    
    mainFrame.BackgroundColor3 = Color3.fromRGB(30, 40, 35)
    
    print("✅ Desync ativado!")
end

-- Resetar desync
local function resetarDesync()
    desyncAtivo = false
    statusLabel.Text = textos[idiomaAtual].statusDesativado
    statusLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
    
    pcall(function()
        setfflag("NextGenReplicatorEnabledWrite4", "False")
    end)
    
    if characterConnection then
        characterConnection:Disconnect()
        characterConnection = nil
    end
    
    if tpCheckConnection then
        tpCheckConnection:Disconnect()
        tpCheckConnection = nil
    end
    
    if youLabel then
        youLabel:Destroy()
        youLabel = nil
    end
    
    youTextLabel = nil
    desyncPosicaoSalva = nil
    
    mainFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
    
    print("❌ Desync desativado!")
end

